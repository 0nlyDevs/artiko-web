# The same Neon database as artiko-api: Better Auth keeps its tables in the `better_auth` schema.
# Use Neon's direct endpoint (host without -pooler): the pooler rejects the search_path option.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/artiko?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
# Any long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8000
