# Keycloak realm `lova` (SOLUTION-6, 12.6). Create a confidential client with the Authorization
# Code flow and PKCE, redirect URI http://localhost:3000/api/auth/callback/keycloak, and an
# audience mapper that adds the API's audience (AUTH_AUDIENCE in artiko-api) to access tokens.
KEYCLOAK_ISSUER=http://localhost:8080/realms/lova
KEYCLOAK_ID=lova-web
KEYCLOAK_SECRET=
# Auth.js: public URL of this app and the key that encrypts the session cookie (`openssl rand -base64 32`).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8000
