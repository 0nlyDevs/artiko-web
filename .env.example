# Same Neon database as artiko-api (Better Auth uses schema `better_auth`, the API uses `app`).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/artiko?sslmode=require
# Public URL of this app. artiko-api must use the same value for AUTH_ISSUER and AUTH_AUDIENCE.
BETTER_AUTH_URL=http://localhost:3000
# Required in production: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Header your hosting proxy sets and overwrites with the real client IP (x-real-ip, cf-connecting-ip...).
# The sign-in rate limit keys on it: never list a header the client can send.
AUTH_CLIENT_IP_HEADER=x-forwarded-for
